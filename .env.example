# 이 파일을 .env 로 복사해서 쓰세요 (.env 는 git 에 올리지 않습니다)
#
# 데이터 출처는 **빌드할 때** 정해집니다. 실행 중에 바뀌지 않고, 폴백도 없습니다.
# 백엔드에 못 붙으면 화면은 오류를 보여주고 멈춥니다 — 목 데이터로 대신 채우지 않습니다.
# (현장에서 그 숫자가 진짜인지 알 수 없게 되므로. src/services/apiMode.ts 참고)

# ── 1) 데모 · 프론트 단독 개발 : 브라우저 안 목 데이터 ─────────────
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=

# ── 2) 백엔드(WMS_back) 연동 · 사내 배포 : DB 데이터만 ─────────────
# VITE_USE_MOCK_API=false
# VITE_API_BASE_URL=http://localhost:18080/api      # 로컬 백엔드
# VITE_API_BASE_URL=https://wms.사내주소/api         # 사내 서버
#
# ⚠ false 로 두고 주소를 비우면 목으로 넘어가지 않고 **모든 화면이 오류**를 냅니다.
#   (설정을 빠뜨린 채 배포했는데 아무도 모르는 상황을 막기 위한 것입니다)
