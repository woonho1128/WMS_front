{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    /* 산출물을 소스 옆에 두지 않는다 — Vite 는 vite.config.js 를 .ts 보다 먼저 읽으므로,
       컴파일된 vite.config.js 가 남아 있으면 vite.config.ts 를 고쳐도 아무 일도 일어나지 않는다 */
    "outDir": "node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
